{
  "name": "monogame-playground-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "stage:monogame": "bash ../../scripts/verify-monogame-artifacts.sh && node scripts/stage-monogame.mjs",
    "stage:compiler": "node scripts/stage-compiler.mjs",
    "stage:compiler:proof": "MONOGAME_FRONTEND_PROFILE=proof node scripts/stage-compiler.mjs",
    "stage:preview": "node scripts/stage-preview.mjs",
    "stage:preview:proof": "MONOGAME_FRONTEND_PROFILE=proof node scripts/stage-preview.mjs",
    "test:stage-preview-clean": "bash scripts/test-stage-preview-clean.sh",
    "test:stage-preview-proof-clean": "bash scripts/test-stage-preview-proof-clean.sh",
    "test:stage-compiler-clean": "bash scripts/test-stage-compiler-clean.sh",
    "test:stage-compiler-proof-clean": "bash scripts/test-stage-compiler-proof-clean.sh",
    "test:stage-issue21-clean": "bash scripts/test-stage-issue21-clean.sh",
    "test:verify-profiles-static": "bash scripts/test-verify-profiles-static.sh",
    "test:preview-native-artifacts": "bash ../../scripts/test-preview-native-artifacts.sh",
    "test:protocol": "node --experimental-strip-types --test src/protocol.test.ts",
    "check:profiles": "node scripts/check-profile-artifacts.mjs both",
    "check:profile-product": "node scripts/check-profile-artifacts.mjs product",
    "check:profile-proof": "node scripts/check-profile-artifacts.mjs proof",
    "verify:profiles": "bash scripts/verify-profiles.sh",
    "test:performance-report": "node --test ../../scripts/performance-report.test.mjs",
    "test:measure-performance": "node --test ../../scripts/measure-performance.test.mjs",
    "measure:performance": "node ../../scripts/measure-performance.mjs",
    "typecheck": "tsc --noEmit",
    "stage": "npm run stage:monogame && npm run stage:compiler && npm run stage:preview",
    "stage:proof": "npm run stage:monogame && npm run stage:compiler:proof && npm run stage:preview:proof",
    "dev": "npm run stage && vite",
    "dev:proof": "MONOGAME_FRONTEND_PROFILE=proof npm run stage:proof && MONOGAME_FRONTEND_PROFILE=proof vite",
    "build:vite": "vite build",
    "build:vite:proof": "MONOGAME_FRONTEND_PROFILE=proof vite build",
    "build": "npm run stage && npm run build:vite",
    "build:proof": "npm run stage:proof && npm run build:vite:proof"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "vite": "8.2.2"
  },
  "dependencies": {
    "monaco-editor": "0.56.0"
  }
}
