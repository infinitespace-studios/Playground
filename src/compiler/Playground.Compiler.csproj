<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <WasmMainJSPath>wwwroot/compiler-harness.js</WasmMainJSPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <WasmExtraFilesToDeploy Include="wwwroot/index.html" />
  </ItemGroup>

  <Target Name="ConfigureCompilerAppBundle" BeforeTargets="PrepareInputsForWasmBuild">
    <PropertyGroup>
      <WasmGenerateAppBundle>true</WasmGenerateAppBundle>
      <WasmAppDir>$([MSBuild]::NormalizeDirectory($(OutputPath), 'browser-wasm', 'AppBundle'))</WasmAppDir>
    </PropertyGroup>
  </Target>

  <Target Name="EmbedTemporaryCompilerReference"
          BeforeTargets="CoreCompile"
          DependsOnTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_TemporaryCompilerReference Include="@(ReferencePath)"
                                   Condition="'%(ReferencePath.Filename)' == 'System.Runtime'" />
      <_CoreCompileResourceInputs Include="@(_TemporaryCompilerReference)"
                                  LogicalName="Playground.Compiler.References.System.Runtime.dll"
                                  ManifestResourceName="Playground.Compiler.References.System.Runtime.dll"
                                  WithCulture="false"
                                  Type="Non-Resx" />
    </ItemGroup>
    <Error Condition="'@(_TemporaryCompilerReference)' == ''"
           Text="The temporary System.Runtime compiler reference could not be resolved." />
  </Target>
</Project>
