<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <WasmMainJSPath>wwwroot/compiler-harness.js</WasmMainJSPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <WasmExtraFilesToDeploy Include="wwwroot/index.html" />
    <WasmExtraFilesToDeploy Include="../shared/ProtocolRuntime.js" TargetPath="ProtocolRuntime.js" />
    <WasmExtraFilesToDeploy Include="../shared/Issue21Endpoints.js" TargetPath="Issue21Endpoints.js" />
    <EmbeddedResource Include="References/*.dll">
      <LogicalName>Playground.Compiler.References.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../../docs/reference-allowlist.json">
      <Link>ReferenceAllowlist/reference-allowlist.json</Link>
      <LogicalName>Playground.Compiler.ReferenceAllowlist.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="ConfigureCompilerAppBundle" BeforeTargets="PrepareInputsForWasmBuild">
    <PropertyGroup>
      <WasmGenerateAppBundle>true</WasmGenerateAppBundle>
      <WasmAppDir>$([MSBuild]::NormalizeDirectory($(OutputPath), 'browser-wasm', 'AppBundle'))</WasmAppDir>
    </PropertyGroup>
  </Target>

  <Target Name="VerifyCompilerReferences" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(NETCoreSdkVersion)' != '9.0.315'"
           Text="The browser compiler requires .NET SDK 9.0.315. Run: cd src/compiler &amp;&amp; dotnet build --configuration Release" />
    <Exec Condition="'$(OS)' != 'Windows_NT'"
          Command="bash &quot;$(MSBuildProjectDirectory)/../../scripts/collect-compiler-references.sh&quot; --verify" />
    <Exec Condition="'$(OS)' == 'Windows_NT'"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../../scripts/collect-compiler-references.ps1&quot; -Verify" />
  </Target>
</Project>
